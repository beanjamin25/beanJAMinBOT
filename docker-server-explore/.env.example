IMAGE_TAG=1.0.0

# Bottle app image (from private registry)
BOTTLE_IMAGE=registry.example.com/bottle-app

# Nginx image tag (uses official nginx image)
NGINX_TAG=latest

# Kerberos principal name
KRB5_PRINCIPAL=my_robot_account

# Host paths to SSL certificates
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Host path to Kerberos keytab
KEYTAB_PATH=/path/to/robot.keytab
